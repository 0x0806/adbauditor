{
  "name": "adbauditor",
  "version": "2.1.1",
  "description": "Browser-based Android security auditing platform (WebUSB + ADB). Created by Sandeep Wawdane; enhanced by 0x0806.",
  "private": true,
  "scripts": {
    "test": "node --test --test-force-exit --test-timeout=20000 \"tests/*.test.js\"",
    "lint": "node scripts/check-syntax.js && eslint .",
    "test:e2e": "node tests/e2e/run.js",
    "serve": "python3 -m http.server 8080",
    "test:site": "node scripts/site-check.js",
    "screenshots": "node scripts/site-check.js --screenshots img/screenshots"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "CC-BY-NC-ND-4.0",
  "author": "Sandeep Wawdane (original creator)",
  "contributors": [
    "0x0806 (enhancements)"
  ],
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  }
}
